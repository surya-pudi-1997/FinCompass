{
  "name": "fin-compass",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:base": "turbo run build --filter=base",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@fin-compass/tsconfig": "^0.0.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.13.4"
  },
  "workspaces": [
    "apps/backend/*",
    "apps/frontend/*",
    "packages/*"
  ]
}
