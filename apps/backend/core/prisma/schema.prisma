generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @unique
  passwordHash      String
  fullName          String
  preferredCurrency String
  networth          Decimal?              @db.Decimal
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  isActive          Boolean               @default(true)
  lastLogin         DateTime?             @db.Timestamptz(6)
  accounts          Account[]
  assets            Asset[]
  insurances        Insurance[]
  reminders         Reminder[]
  transactions      Transaction[]
  categories        TransactionCategory[]
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  name          String
  type          String
  balance       Decimal?      @db.Decimal
  encryptedData Bytes?
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]

  @@index([userId])
}

model Asset {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  type         String
  bought_value Decimal       @db.Decimal
  sold_value   Decimal?      @db.Decimal
  expense      Decimal       @default(0) @db.Decimal
  income       Decimal       @default(0) @db.Decimal
  status       String
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model TransactionCategory {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  type         String
  icon         String?
  isSystem     Boolean       @default(false)
  userId       String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("transaction_categories")
}

model Transaction {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  accountId  String              @db.Uuid
  assetId    String?             @db.Uuid
  type       String
  amount     Decimal             @db.Decimal
  categoryId String              @db.Uuid
  note       String?
  timestamp  DateTime            @db.Timestamptz(6)
  account    Account             @relation(fields: [accountId], references: [id])
  asset      Asset?              @relation(fields: [assetId], references: [id])
  category   TransactionCategory @relation(fields: [categoryId], references: [id])
  user       User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([assetId])
  @@index([categoryId])
}

model Insurance {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  type           String
  premium        Decimal  @db.Decimal
  policyDocUrl   String?
  payoutReceived Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Reminder {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  title    String
  dueDate  DateTime @db.Date
  category String
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
